# Copy to .env (local dev only — NEVER commit .env) or set these in your
# hosting provider's environment-variable dashboard. No real values here.

# LiveKit project WebSocket URL (from your LiveKit dashboard)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key + secret (from your LiveKit dashboard, Project Settings > Keys)
LIVEKIT_API_KEY=your-api-key-here
LIVEKIT_API_SECRET=your-api-secret-here

# NEW instructor passphrase. Pick something fresh and strong — do NOT reuse
# the old client-side one. Only the instructor ever types this; it is checked
# on the server and never sent back to any browser.
INSTRUCTOR_PASSPHRASE=choose-a-new-strong-passphrase-here

# Comma-separated room names this server is allowed to mint tokens for.
# Keep this to just your classroom room unless you need breakout rooms.
ALLOWED_ROOMS=chess-classroom

# Comma-separated origins allowed to call /token from a browser.
ALLOWED_ORIGINS=https://muse.ai/s/chess-classroom-gxq6v0xq3ldl0,http://localhost:3000

# Local dev port only
PORT=3001
